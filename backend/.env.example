# ==============================================================================
# Volcano — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# FOR PRODUCTION (Google Cloud Run / Secret Manager):
# Store all sensitive values in Google Cloud Secret Manager and inject them
# into Cloud Run service containers as environment variables.
# ==============================================================================

# --- AI & Reasoning Engine ---
# Google Gemini API key required for the multi-agent pipeline
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Database ---
# Leave empty for local SQLite (backend/ideas.db), or provide PostgreSQL URI
DATABASE_URL=postgresql://dbuser:dbpassword@dbhost:5432/volcano_production

# --- Cryptographic Security & Authentication (JWT) ---
# Long, random 32+ character secret string for signing JWT tokens
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ACCESS_EXPIRES_HOURS=24
JWT_REFRESH_EXPIRES_DAYS=30

# Secure Admin access code for Volcano Thinking Engine
VOLCANO_ADMIN_KEY=your_secure_admin_key_here

# --- Network & CORS ---
# Comma-separated list of allowed origins. Cloud Run services matching *.run.app are supported.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://volcanolanding-run.app

# --- LangSmith Observability ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="Volcano"

# --- Email & Communication Verification (Dual OTP) ---
# Supported Email Options:
# 1. Google Workspace / Gmail SMTP Relay: smtp.gmail.com (Port 587) with App Password
# 2. GCP SendGrid Marketplace: smtp.sendgrid.net (Port 587, User: apikey, Password: <sendgrid_api_key>)
# If unconfigured, Volcano automatically operates in Dev Simulation Mode (logs OTPs to server console).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@volcano.market

# Supported Mobile SMS Options:
# Twilio Programmable SMS (or any standard SMS gateway):
# If unconfigured, Volcano operates in Dev Simulation Mode (logs OTPs to server console).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
